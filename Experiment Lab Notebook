']\n\n    # OPTIMASI MEMORI 1: Hanya baca 2 baris train.csv sebagai cetakan header\n    train = pd.read_csv(os.path.join(root, 'data/datasets/train.csv'), nrows=2)    \n    test = pd.read_csv(test_file, low_memory=False)\n\n    if file_state == 'unannotated':\n        bpca_file = os.path.join(root, f'data/temp/{os.path.splitext(os.path.basename(test_file))[0]}_bpca.csv')\n        data_bpca = pd.read_csv(bpca_file, header=None)\n        # Amankan pemotongan dimensi BPCA\n        data_bpca.columns = test.columns[7 : 7 + data_bpca.shape[1]]\n        test = pd.concat([test.iloc[:, :7], data_bpca], axis=1)\n\n    for col in feature_list:\n        if col not in test.columns:\n            test[col] = 0.0\n        test[col] = test[col].replace('-', np.nan).replace('.', np.nan)\n        \n    features = joblib.load(autoFE_features)\n\n    X_train = train[feature_list].astype('float64')\n    X_test = test[feature_list].astype('float64')\n\n    print('---' + time.asctime(time.localtime(time.time())) + '--- transforming dataset (OPTIMASI MEMORI AKTIF)\\\\n')\n    \n    # OPTIMASI MEMORI 2: Turunkan n_jobs menjadi 2 agar RAM Kaggle tidak jebol\n    _, X_test_tr = transform(X_train, X_test, features, n_jobs=2)\n    \n    feature_list_sel = pd.read_csv(selection).feature.tolist()\n    X_test_filtered = X_test_tr[feature_list_sel].astype('float64')\n\n    # OPTIMASI MEMORI 3: Konversi ke NumPy Array untuk membuang beban Pandas\n    X_matrix = X_test_filtered.values\n\n    print('---' + time.asctime(time.localtime(time.time())) + '--- predicting\\\\n')\n    model = joblib.load(model_file)\n    test_pred = model.predict(X_matrix)\n    \n    result_df = pd.concat([test, pd.DataFrame(test_pred, columns=['MAGPIE_pred'])], axis=1)\n    result_df.to_csv(os.path.join(root, f'data/result/{filename}.csv'), index=False)\n    \n    return result_df\n\"\"\"\n\nwith open(\"python/predict.py\", \"w\", encoding=\"utf-8\") as f:\n    f.write(kode_predict)\n\nprint(\"[SUKSES] predict.py telah ditambal dengan Optimasi Memori.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-09T14:50:44.700245Z","iopub.execute_input":"2026-07-09T14:50:44.700869Z","iopub.status.idle":"2026-07-09T14:50:44.71981Z","shell.execute_reply.started":"2026-07-09T14:50:44.70083Z","shell.execute_reply":"2026-07-09T14:50:44.71868Z"}},"outputs":[{"name":"stdout","text":"[SUKSES] predict.py telah ditambal dengan Optimasi Memori.\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"# !bash magpie.sh --mode pred --file_state annotated --test_file data/datasets/test.csv --model_file data/result/MAGPIE_denovo.model --feature data/result/openFE.features --selection data/result/selection.csv --visualization","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-09T14:50:59.451124Z","iopub.execute_input":"2026-07-09T14:50:59.451671Z","iopub.status.idle":"2026-07-09T14:51:50.838943Z","shell.execute_reply.started":"2026-07-09T14:50:59.451633Z","shell.execute_reply":"2026-07-09T14:51:50.837876Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[{"name":"stdout","text":"Visualization Directory made\n---Thu Jul  9 14:51:05 2026--- transforming dataset (OPTIMASI MEMORI AKTIF)\\n\n---Thu Jul  9 14:51:44 2026--- predicting\\n\n---Thu Jul  9 14:51:45 2026--- visualizing result.\n\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman' not found.\nfindfont: Font family 'Times New Roman